

# --- Production (Render) ---
# Leave DATABASE_URL unset locally to use the SQLite file in data/. In production set it to a Neon/Postgres connection string.
# DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require
# PRODUCTION=true
# FLASK_SECRET_KEY=<a long random value>
# WRITE_LIMIT_PER_MINUTE=60
# AUTH_LIMIT_PER_15_MIN=20
# DAILY_SIGNUP_LIMIT=100
# DAILY_SUMMARY_LIMIT=50
# DAILY_SCREENSHOT_LIMIT=20
# DAILY_FOOD_LOOKUP_LIMIT=200
# MAX_FOODS_PER_USER=200
# KEEP_PLAN_BATCHES=10
# MAX_UPLOAD_MB=50
# MAX_EXPORT_XML_MB=150
